{
  "manifest_version": 3,
  "name": "Easy Vote(Auto Vote for Minecraft Servers)",
  "description": "Расширение для автоматического голосования за Minecraft-сервер на сайте minecraft-servers.ru.",
  "version": "1.0",
  "author": "La3ert",
  "action": {
    "default_popup": "html/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://minecraft-servers.ru/server/*",
        "https://accounts.google.com/*"],

      "js": ["js/content.js"]
    }
  ],

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],

  "background": {
    "service_worker": "js/background.js"
  },

  "options_page": "html/options.html"
}
