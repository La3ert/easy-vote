{
  "manifest_version": 3,
  "name": "Easy Vote(Auto Vote for Minecraft Servers)",
  "description": "Расширение для автоматического голосования за Minecraft-сервер на сайте minecraft-servers.ru.",
  "version": "1.0",
  "author": "La3ert",
  "content_scripts": [
    {
      "matches": ["https://minecraft-servers.ru/*",
        "https://accounts.google.com/*"],

      "js": ["js/content.js"]
    }
  ],
  "icons": {
    "16": "resources/icons/Logo16.png",
    "32": "resources/icons/Logo32.png",
    "48": "resources/icons/Logo64.png",
    "128": "resources/icons/Logo128.png"
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_icon": {
      "16": "resources/icons/Logo16.png",
      "32": "resources/icons/Logo32.png",
      "48": "resources/icons/Logo64.png",
      "128": "resources/icons/Logo128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],

  "background": {
    "service_worker": "js/background.js"
  },

  "options_page": "html/options.html"
}
